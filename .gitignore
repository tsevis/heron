# Project instructions & phase plans — local-only. These name absolute machine
# paths and other private projects, so they must never reach the public repo
# (CLAUDE.md was already purged from git history once for exactly this).
/CLAUDE.md
/documents/

# Heron — never commit weights, caches, or venv
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
